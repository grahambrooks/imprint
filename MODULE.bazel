module(
    name = "imprint",
    version = "0.0.0",
)

bazel_dep(
    name = "rules_go",
    version = "0.62.0",
    repo_name = "io_bazel_rules_go",
)

bazel_dep(
    name = "gazelle",
    version = "0.51.3",
    repo_name = "bazel_gazelle",
)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

use_repo(
    go_deps,
    "com_github_spf13_cobra",
    "com_github_stretchr_testify",
)
